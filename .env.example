# OAuth app credentials — register your app at https://www.mixcloud.com/developers/
# Required to run: mixcloud-mcp-oauth
MIXCLOUD_CLIENT_ID=
MIXCLOUD_CLIENT_SECRET=

# Populated automatically by: mixcloud-mcp-oauth
# Public endpoints work without this. Required for uploads, favorites, etc.
MIXCLOUD_ACCESS_TOKEN=

# Generate a secure key with: mixcloud-mcp-keygen
MCP_API_KEY=your_secret_api_key_here

# HTTP server port (default: 8000)
MCP_PORT=8000

# Public base URL of the HTTP server — used by the upload UI to POST files.
# Set this when hosting remotely. Defaults to http://localhost:<MCP_PORT>.
# MCP_PUBLIC_URL=https://your-server.example.com

# Allowed CORS origin for the upload endpoint. Defaults to * (all origins).
# Lock this down to your frontend's origin in production.
# CORS_ORIGIN=https://your-frontend.example.com

# Set to true to disable Bearer token auth — local dev only, never in production
# DISABLE_AUTH=true
