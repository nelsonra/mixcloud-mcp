# OAuth app credentials — register your app at https://www.mixcloud.com/developers/
# When both are set, the HTTP server uses OAuth instead of MCP_API_KEY.
# The redirect URI to register in your Mixcloud app: <MCP_PUBLIC_URL>/auth/callback
MIXCLOUD_CLIENT_ID=
MIXCLOUD_CLIENT_SECRET=

# Populated automatically by: mixcloud-mcp-oauth (stdio / local CLI auth flow).
# Not needed when the HTTP server uses the OAuth proxy above.
MIXCLOUD_ACCESS_TOKEN=

# Simple Bearer token auth — used when MIXCLOUD_CLIENT_ID / SECRET are not set.
# Generate a secure key with: mixcloud-mcp-keygen
MCP_API_KEY=your_secret_api_key_here

# HTTP server port (default: 8000)
MCP_PORT=8000

# Sidecar port for stdio mode (default: 4000).
# Handles /upload and /oauth/* when running via Claude Desktop (stdio transport).
# UPLOAD_PORT=4000

# Public base URL of the HTTP server — REQUIRED when using OAuth (the proxy needs
# to construct its own redirect URI: <MCP_PUBLIC_URL>/auth/callback).
# Also used by the upload UI to POST files.
# Defaults to http://localhost:<MCP_PORT> which works for local dev.
# MCP_PUBLIC_URL=https://your-server.example.com

# Allowed CORS origin for the upload endpoint. Defaults to * (all origins).
# Lock this down to your frontend's origin in production.
# CORS_ORIGIN=https://your-frontend.example.com

# Set to true to disable Bearer token auth — local dev only, never in production
# DISABLE_AUTH=true
